# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
DATABASE_URL=sqlite:///./disputeshield.db
CHECKPOINT_DB=./checkpoints.db
SETTLE_THRESHOLD=25
# LLMs, tried in order (a provider with no key is skipped).
# Groq: console.groq.com/keys  ·  Gemini: aistudio.google.com/apikey
LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# comma-separated models are tried in order
GEMINI_MODEL=gemini-3.8-flash,gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173
# Webhook ID shown in developer.paypal.com > your sandbox app > Webhooks (subscribe to
# CUSTOMER.DISPUTE.CREATED / UPDATED / RESOLVED at https://<api-host>/webhooks/paypal)
PAYPAL_WEBHOOK_ID=
POLL_DISPUTES=true
POLL_INTERVAL_S=60
# Dev only: directory to save raw webhook bodies+headers (to record real test fixtures)
WEBHOOK_RECORD_DIR=
# Evidence summary PDFs
ARTIFACTS_DIR=./artifacts
# Shared secret for /admin/sandbox/* demo helpers (header X-Admin-Token). Empty = disabled.
ADMIN_TOKEN=
# Merchant login: Log in with PayPal. Enable it on your sandbox app (Apps & Credentials > app >
# Log in with PayPal) and add AUTH_REDIRECT_URI as a Return URL. AUTH_MODE=off = no login (local dev only;
# ignored on Render).
AUTH_MODE=paypal
AUTH_SECRET=
AUTH_REDIRECT_URI=http://localhost:8000/api/auth/paypal/callback
# Also the base of the buyer troubleshooting links sent through PayPal (must be public in production).
FRONTEND_URL=http://localhost:5173
MERCHANT_LOGIN_EMAILS=
# Phase 9B: buyer troubleshooting. Research uses GEMINI_API_KEY (Grounding with Google Search via the
# Interactions API, store=false); TAVILY_API_KEY is an optional fallback. RESEARCH_MODEL defaults to GEMINI_MODEL.
TAVILY_API_KEY=
RESEARCH_MODEL=
# Base URL for buyer troubleshooting links if the buyer pages are served from a different host (default FRONTEND_URL).
BUYER_PORTAL_URL=
# Buyer proof uploads (kept under ARTIFACTS_DIR/ts/<session>/): images <= 10 MB, videos <= 50 MB and 30 s.
PROOF_IMAGE_MAX_BYTES=10485760
PROOF_VIDEO_MAX_BYTES=52428800
PROOF_VIDEO_MAX_SECONDS=30
# Advisory Gemini check of proof photos (merchant-only hint, never decides). Off by default: Gemini's free tier
# may use inputs for review/training, so only enable with a paid key or the buyer's consent.
PROOF_VISION_CHECK=false
VISION_MODEL=
# Store name on the buyer's help page header.
STORE_NAME=Demo store
# When the buyer finishes troubleshooting, re-analyse the dispute with the result (Phase 9D).
TROUBLESHOOTING_REANALYSE=true
