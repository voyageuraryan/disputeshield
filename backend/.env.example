# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
DATABASE_URL=sqlite:///./disputeshield.db
CHECKPOINT_DB=./checkpoints.db
SETTLE_THRESHOLD=25
# LLMs, tried in order (a provider with no key is skipped).
# Groq: console.groq.com/keys  ·  Gemini: aistudio.google.com/apikey
LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# comma-separated models are tried in order
GEMINI_MODEL=gemini-3.8-flash,gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173
# Webhook ID shown in developer.paypal.com > your sandbox app > Webhooks (subscribe to
# CUSTOMER.DISPUTE.CREATED / UPDATED / RESOLVED at https://<api-host>/webhooks/paypal)
PAYPAL_WEBHOOK_ID=
POLL_DISPUTES=true
POLL_INTERVAL_S=60
# Dev only: directory to save raw webhook bodies+headers (to record real test fixtures)
WEBHOOK_RECORD_DIR=
# Evidence summary PDFs
ARTIFACTS_DIR=./artifacts
# Shared secret for /admin/sandbox/* demo helpers (header X-Admin-Token). Empty = disabled.
ADMIN_TOKEN=
# Merchant login: Log in with PayPal. Enable it on your sandbox app (Apps & Credentials > app >
# Log in with PayPal) and add AUTH_REDIRECT_URI as a Return URL. AUTH_MODE=off = no login (local dev only;
# ignored on Render).
AUTH_MODE=paypal
AUTH_SECRET=
AUTH_REDIRECT_URI=http://localhost:8000/api/auth/paypal/callback
# Also the base of the buyer troubleshooting links sent through PayPal (must be public in production).
FRONTEND_URL=http://localhost:5173
MERCHANT_LOGIN_EMAILS=
